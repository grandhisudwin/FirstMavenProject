pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                bat 'C:/apache-maven-3.9.16/bin/mvn.cmd clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'C:/apache-maven-3.9.16/bin/mvn.cmd test'
            }
        }

        stage('Package') {
            steps {
                bat 'C:/apache-maven-3.9.16/bin/mvn.cmd package'
            }
        }
    }

    post {
        success {
            emailext(
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "The Jenkins CI pipeline completed successfully.",
                to: "grandhisudvin@gmail.com"
            )
        }

        failure {
            emailext(
                subject: "FAILURE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "The Jenkins CI pipeline failed. Please check the Jenkins console output.",
                to: "grandhisudvin@gmail.com"
            )
        }
    }
}