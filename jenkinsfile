pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                bat 'C:/apache-maven-3.9.16/bin/mvn.cmd clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'C:/apache-maven-3.9.16/bin/mvn.cmd test'
            }
        }

        stage('Package') {
            steps {
                bat 'C:/apache-maven-3.9.16/bin/mvn.cmd package'
            }
        }
    }

    post {
        success {
            echo 'CI Pipeline completed successfully!'
        }

        failure {
            echo 'CI Pipeline failed!'
        }
    }
}
